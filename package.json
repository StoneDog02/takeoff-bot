{
  "name": "takeoff-bot",
  "version": "0.1.0",
  "description": "Reusable AI construction takeoff engine — scope pipeline framework",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx src/app.ts",
    "ui:dev": "tsx src/ui/startUiServer.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "ui": "node dist/ui/startUiServer.js",
    "test": "tsx --test tests/**/*.test.ts",
    "test:live-framing": "TAKEOFF_LIVE_CLAUDE=1 tsx --test tests/integration/framing.live-claude.test.ts",
    "test:live-framing-two-wall": "TAKEOFF_LIVE_CLAUDE=1 tsx --test tests/integration/framing.live-claude-two-wall.test.ts",
    "test:live-framing-two-wall-conflict": "TAKEOFF_LIVE_CLAUDE=1 tsx --test tests/integration/framing.live-claude-two-wall-conflict.test.ts",
    "test:live-framing-mixed-domain": "TAKEOFF_LIVE_CLAUDE=1 tsx --test tests/integration/framing.live-claude-mixed-domain.test.ts",
    "test:live-framing-opening": "TAKEOFF_LIVE_CLAUDE=1 tsx --test tests/integration/framing.live-claude-opening.test.ts",
    "test:live-framing-opening-header": "TAKEOFF_LIVE_CLAUDE=1 tsx --test tests/integration/framing.live-claude-opening-header.test.ts",
    "test:live-framing-multi-object": "TAKEOFF_LIVE_CLAUDE=1 tsx --test tests/integration/framing.live-claude-multi-object.test.ts",
    "proof:live-framing": "tsx src/app.ts --live --pdf tests/fixtures/wall-w001-text-layer.pdf --scope framing --project live-proof-w001",
    "proof:live-framing-two-wall": "tsx src/app.ts --live --pdf tests/fixtures/wall-w001-w002-text-layer.pdf --scope framing --project live-proof-w001-w002",
    "proof:live-framing-two-wall-conflict": "tsx src/app.ts --live --pdf tests/fixtures/wall-w001-w002-conflict-text-layer.pdf --scope framing --project live-proof-w001-w002-conflict",
    "proof:live-framing-causality": "npm run proof:live-framing-20ft && npm run proof:live-framing-24ft",
    "proof:live-framing-20ft": "tsx src/app.ts --live --pdf tests/fixtures/wall-w001-text-layer.pdf --scope framing --project live-proof-w001-20ft",
    "proof:live-framing-24ft": "tsx src/app.ts --live --pdf tests/fixtures/wall-w001-24ft-text-layer.pdf --scope framing --project live-proof-w001-24ft",
    "proof:live-framing-mixed-domain-6ft": "tsx src/app.ts --live --pdf tests/fixtures/wall-w001-hdr001-text-layer.pdf --scope framing --project live-proof-w001-hdr001-6ft",
    "proof:live-framing-mixed-domain-8ft": "tsx src/app.ts --live --pdf tests/fixtures/wall-w001-hdr001-8ft-text-layer.pdf --scope framing --project live-proof-w001-hdr001-8ft",
    "proof:live-framing-mixed-domain-causality": "npm run proof:live-framing-mixed-domain-6ft && npm run proof:live-framing-mixed-domain-8ft"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@opendataloader/pdf": "^2.5.1",
    "dotenv": "^16.4.7",
    "pdf-to-img": "^6.2.0",
    "pdfjs-dist": "~5.6.205",
    "pngjs": "^7.0.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
