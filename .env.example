ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Residential framing reader composition
# TAKEOFF_COMPILER / TAKEOFF_PROJECT_LEARNING / TAKEOFF_COMPILER_OCR:
#   1 = force on, 0 = force off, unset = auto-on for empty-text (OCR-heavy) PDFs
# Text-layer fixtures stay cheap unless forced on.

# Drawing compiler (geometry / marks / schedules from pages)
TAKEOFF_COMPILER=
# Include OCR for empty-text pages when compiling
TAKEOFF_COMPILER_OCR=
# Optional page cap for compiler
TAKEOFF_COMPILER_MAX_PAGES=

# Project Learning — harvest schedule/legend definitions into the project dictionary
# Requires Java 11+ for ODL hybrid when used on textless schedules.
TAKEOFF_PROJECT_LEARNING=
TAKEOFF_ODL_HYBRID_URL=

# Project orientation + DictionaryGovernor (still opt-in)
TAKEOFF_PROJECT_ORIENTATION=

# Extra semantic-binding / opening-geometry Evidence bridges (not auto-on)
TAKEOFF_SEMANTIC_BINDING=
TAKEOFF_OPENING_GEOMETRY=

# Illustrative Claude USD/MTok for READ call-ledger estimates (not an invoice)
TAKEOFF_CLAUDE_INPUT_USD_PER_MTOK=
TAKEOFF_CLAUDE_OUTPUT_USD_PER_MTOK=
TAKEOFF_CLAUDE_CACHE_READ_USD_PER_MTOK=
TAKEOFF_CLAUDE_CACHE_WRITE_USD_PER_MTOK=

# UI access boundary: customer (default) | developer
# developer returns contractor takeoff + taxonomy accounting diagnostics
# customer returns contractor takeoff only (no gap map / debug fields)
TAKEOFF_UI_ACCESS=

# Optional UI port (default 3000)
TAKEOFF_UI_PORT=
