ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Residential framing reader composition (OCR-heavy PDFs such as Beckstead)
# Enable as needed; off = lighter text-layer / mock-friendly path.

# Drawing compiler (geometry / marks / schedules from pages)
TAKEOFF_COMPILER=
# Include OCR for empty-text pages when compiling
TAKEOFF_COMPILER_OCR=
# Optional page cap for compiler
TAKEOFF_COMPILER_MAX_PAGES=

# Project Learning — harvest schedule/legend definitions into the project dictionary
# Requires Java 11+ for ODL hybrid when used on textless schedules.
TAKEOFF_PROJECT_LEARNING=
TAKEOFF_ODL_HYBRID_URL=

# Project orientation + DictionaryGovernor
TAKEOFF_PROJECT_ORIENTATION=

# Extra semantic-binding / opening-geometry Evidence bridges
TAKEOFF_SEMANTIC_BINDING=
TAKEOFF_OPENING_GEOMETRY=

# UI access boundary: customer (default) | developer
# developer returns contractor takeoff + taxonomy accounting diagnostics
# customer returns contractor takeoff only (no gap map / debug fields)
TAKEOFF_UI_ACCESS=

# Optional UI port (default 3000)
TAKEOFF_UI_PORT=
